{
  "name": "@siglo/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:load": "node scripts/load-test.mjs",
    "test:stress": "node scripts/stress-test.mjs",
    "test:security": "playwright test e2e/security.spec.ts --workers=1",
    "test:smoke": "playwright test e2e/smoke.spec.ts --workers=1",
    "test:final": "node scripts/load-test.mjs && node scripts/stress-test.mjs && playwright test e2e/security.spec.ts --workers=1 && playwright test e2e/smoke.spec.ts --workers=1",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@siglo/ui": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "lucide-react": "^0.546.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3"
  }
}
