# SIGLO — EXEMPLO de variáveis de ambiente (APENAS valores fictícios/de desenvolvimento)
#
# Como usar:
#   1. Copie:  cp env.example .env
#   2. Ajuste localmente se necessário (ex.: trocar a senha dev do Postgres).
#   3. NUNCA commite o .env — ele já está no .gitignore.
#
# ⚠️ Nenhum valor abaixo é um segredo real: são credenciais locais de desenvolvimento,
#    espelhadas no infra/docker-compose.yml. Credenciais de staging/produção vivem
#    exclusivamente em cofre (Freebuff → Keys/API keys / env vars por ambiente).
#    Referência: docs/03-arquitetura/ambientes-e-infraestrutura.md
#
# Nota: o arquivo chama-se env.example (sem ponto inicial) porque a plataforma
# bloqueia a criação de arquivos com padrão ".env*" no repositório.

# PostgreSQL (dev local — igual ao infra/docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=siglo
POSTGRES_PASSWORD=CHANGE_ME_LOCAL
POSTGRES_DB=siglo

# Redis (sessões IAM — Sprint 01)
REDIS_ADDR=localhost:6379

# MinIO / object storage (laudos/DICOM — Sprint 04+; dev local)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_LAUDOS=siglo-laudos
S3_ACCESS_KEY=siglo
S3_SECRET_KEY=CHANGE_ME_LOCAL

# Keycloak (Sprint 01 — ADR-0004)
KEYCLOAK_ISSUER=http://localhost:8081/realms/siglo
KEYCLOAK_CLIENT_ID=siglo-web

# Core API
CORE_HTTP_ADDR=:8080
