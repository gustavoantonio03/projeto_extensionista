{
  "name": "siglo",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @siglo/web",
    "build": "npm run build -w @siglo/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "ui:test": "npm run test -w @siglo/ui",
    "ui:typecheck": "npm run typecheck -w @siglo/ui"
  }
}
